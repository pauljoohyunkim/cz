    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make unittest",
            "type": "shell",
            "command": "make unittest"
        },
        {
            "label": "Make czc",
            "type": "shell",
            "command": "make czc"
        },
        {
            "label": "Make czc (Stop at Lexer)",
            "type": "shell",
            "command": "make czc CFLAGS_EXTRA=-DSTOP_AT_LEXER"
        },
        {
            "label": "Make czc (Stop at Parser)",
            "type": "shell",
            "command": "make czc CFLAGS_EXTRA=-DSTOP_AT_PARSER"
        },
        {
            "label": "Make czc (Stop at Semantic Analyzer)",
            "type": "shell",
            "command": "make czc CFLAGS_EXTRA=-DSTOP_AT_SEMANTIC_ANALYZER"
        }
    ]
}
